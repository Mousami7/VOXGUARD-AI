APP_NAME=VoxGuard-AI
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# Model names (local, no API keys)
WHISPER_MODEL=base
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Uploads (10 MiB)
MAX_UPLOAD_BYTES=10485760

# Optional grounded LLM (leave empty to keep extractive answers)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
MIN_EVIDENCE_SCORE=0.25
